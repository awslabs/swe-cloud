{
 "Outputs": {
  "QueueUrl": {
   "Value": {
    "Ref": "Queue"
   }
  },
  "RoleArn": {
   "Value": {
    "Fn::GetAtt": [
     "Role",
     "Arn"
    ]
   }
  }
 },
 "Parameters": {
  "BucketName": {
   "Type": "String"
  },
  "QueueName": {
   "Type": "String"
  },
  "TableName": {
   "Type": "String"
  }
 },
 "Resources": {
  "Bucket": {
   "Metadata": {
    "aws:cdk:path": "Seed/Bucket"
   },
   "Properties": {
    "BucketName": {
     "Ref": "BucketName"
    }
   },
   "Type": "AWS::S3::Bucket"
  },
  "Queue": {
   "Metadata": {
    "aws:cdk:path": "Seed/Queue"
   },
   "Properties": {
    "QueueName": {
     "Ref": "QueueName"
    }
   },
   "Type": "AWS::SQS::Queue"
  },
  "Role": {
   "Metadata": {
    "aws:cdk:path": "Seed/Role"
   },
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Effect": "Allow",
       "Principal": {
        "Service": "states.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "RoleName": "manifest-gen-role"
   },
   "Type": "AWS::IAM::Role"
  },
  "Table": {
   "Metadata": {
    "aws:cdk:path": "Seed/Table"
   },
   "Properties": {
    "AttributeDefinitions": [
     {
      "AttributeName": "catalog",
      "AttributeType": "S"
     },
     {
      "AttributeName": "file_id",
      "AttributeType": "S"
     }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "KeySchema": [
     {
      "AttributeName": "catalog",
      "KeyType": "HASH"
     },
     {
      "AttributeName": "file_id",
      "KeyType": "RANGE"
     }
    ],
    "TableName": {
     "Ref": "TableName"
    }
   },
   "Type": "AWS::DynamoDB::Table"
  }
 }
}
