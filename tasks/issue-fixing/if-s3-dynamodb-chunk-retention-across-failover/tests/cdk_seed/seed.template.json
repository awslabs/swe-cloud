{
 "Parameters": {
  "BucketName": {
   "Type": "String"
  },
  "TableName": {
   "Type": "String"
  }
 },
 "Resources": {
  "Objects": {
   "Metadata": {
    "aws:cdk:path": "Seed/Objects"
   },
   "Properties": {
    "BucketName": {
     "Ref": "BucketName"
    }
   },
   "Type": "AWS::S3::Bucket"
  },
  "Runs": {
   "Metadata": {
    "aws:cdk:path": "Seed/Runs"
   },
   "Properties": {
    "AttributeDefinitions": [
     {
      "AttributeName": "pk",
      "AttributeType": "S"
     },
     {
      "AttributeName": "sk",
      "AttributeType": "S"
     }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "KeySchema": [
     {
      "AttributeName": "pk",
      "KeyType": "HASH"
     },
     {
      "AttributeName": "sk",
      "KeyType": "RANGE"
     }
    ],
    "TableName": {
     "Ref": "TableName"
    }
   },
   "Type": "AWS::DynamoDB::Table"
  }
 }
}
