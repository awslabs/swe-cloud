{
 "Conditions": {
  "IsProtected": {
   "Fn::Equals": [
    {
     "Ref": "Protected"
    },
    "true"
   ]
  }
 },
 "Outputs": {
  "Arn": {
   "Value": {
    "Ref": "Secret"
   }
  }
 },
 "Parameters": {
  "KeyRef": {
   "Type": "String"
  },
  "Name": {
   "Type": "String"
  },
  "Protected": {
   "Type": "String"
  },
  "Value": {
   "NoEcho": true,
   "Type": "String"
  }
 },
 "Resources": {
  "Secret": {
   "Metadata": {
    "aws:cdk:path": "Seed/Secret"
   },
   "Properties": {
    "KmsKeyId": {
     "Ref": "KeyRef"
    },
    "Name": {
     "Ref": "Name"
    },
    "SecretString": {
     "Ref": "Value"
    },
    "Tags": [
     {
      "Key": "team",
      "Value": "payments"
     },
     {
      "Fn::If": [
       "IsProtected",
       {
        "Key": "DeletionProtection",
        "Value": "true"
       },
       {
        "Ref": "AWS::NoValue"
       }
      ]
     }
    ]
   },
   "Type": "AWS::SecretsManager::Secret"
  }
 }
}
