{
 "Parameters": {
  "InstanceName": {
   "Type": "String"
  }
 },
 "Resources": {
  "Database": {
   "Metadata": {
    "aws:cdk:path": "Seed/Database"
   },
   "Properties": {
    "AllocatedStorage": "20",
    "DBInstanceClass": "db.t3.micro",
    "DBInstanceIdentifier": {
     "Ref": "InstanceName"
    },
    "DBName": "sync",
    "Engine": "postgres",
    "EngineVersion": "16.3",
    "MasterUserPassword": "local-password",
    "MasterUsername": "syncadmin"
   },
   "Type": "AWS::RDS::DBInstance"
  }
 }
}
