{
 "Outputs": {
  "QueueUrl": {
   "Value": {
    "Ref": "Queue"
   }
  }
 },
 "Parameters": {
  "QueueName": {
   "Type": "String"
  },
  "TableName": {
   "Type": "String"
  }
 },
 "Resources": {
  "Queue": {
   "Metadata": {
    "aws:cdk:path": "Seed/Queue"
   },
   "Properties": {
    "ContentBasedDeduplication": false,
    "DelaySeconds": 0,
    "FifoQueue": true,
    "MessageRetentionPeriod": 300,
    "QueueName": {
     "Ref": "QueueName"
    },
    "VisibilityTimeout": 8
   },
   "Type": "AWS::SQS::Queue"
  },
  "Table": {
   "Metadata": {
    "aws:cdk:path": "Seed/Table"
   },
   "Properties": {
    "AttributeDefinitions": [
     {
      "AttributeName": "pk",
      "AttributeType": "S"
     },
     {
      "AttributeName": "sk",
      "AttributeType": "S"
     }
    ],
    "BillingMode": "PAY_PER_REQUEST",
    "KeySchema": [
     {
      "AttributeName": "pk",
      "KeyType": "HASH"
     },
     {
      "AttributeName": "sk",
      "KeyType": "RANGE"
     }
    ],
    "TableName": {
     "Ref": "TableName"
    }
   },
   "Type": "AWS::DynamoDB::Table"
  }
 }
}
