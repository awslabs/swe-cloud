#!/usr/bin/env python3
"""sandbox-cloud: a local stand-in for the cloud API that vm-destroy talks to.

Usage: sandbox-cloud [--default-seconds 6] [--vm ID=SECONDS ...] [--interval 2]

Serves /run/cloud-api.sock until interrupted. Every VM id is accepted; a teardown takes
--default-seconds unless a --vm entry gives that VM its own duration. Each teardown call is written
to stdout as the cloud's audit log records it.
"""

import argparse
import json
import math
import os
import socket
import sys
import threading
import time

SOCKET_PATH = "/run/cloud-api.sock"


def stamp():
    return time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d}"


def serve_one(conn, durations, default_s, interval):
    reader = conn.makefile("r")
    vm_id = None
    finished = False
    try:
        for line in reader:
            message = json.loads(line)
            if message["op"] == "begin":
                vm_id = message["vm_id"]
                seconds = durations.get(vm_id, default_s)
                steps = max(1, math.ceil(seconds / interval))
                print(f"{stamp()} teardown started  vm={vm_id} pid={message['pid']}", flush=True)
                conn.sendall((json.dumps({"ok": True, "steps": steps, "interval": interval}) + "\n").encode())
            elif message["op"] == "done":
                finished = True
                print(f"{stamp()} teardown finished vm={vm_id}", flush=True)
                conn.sendall(b'{"ok": true}\n')
    except (OSError, ValueError):
        pass
    finally:
        if vm_id and not finished:
            print(f"{stamp()} teardown abandoned vm={vm_id}", flush=True)
        conn.close()


def main(argv=None):
    parser = argparse.ArgumentParser(prog="sandbox-cloud")
    parser.add_argument("--default-seconds", type=float, default=6.0)
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--vm", action="append", default=[], metavar="ID=SECONDS")
    args = parser.parse_args(argv)
    durations = {}
    for entry in args.vm:
        vm_id, _, seconds = entry.partition("=")
        durations[vm_id] = float(seconds)

    if os.path.exists(SOCKET_PATH):
        os.unlink(SOCKET_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)
    server.listen(64)
    print(f"{stamp()} sandbox cloud API on {SOCKET_PATH}", flush=True)
    try:
        while True:
            conn, _ = server.accept()
            threading.Thread(target=serve_one, args=(conn, durations, args.default_seconds, args.interval), daemon=True).start()
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
