#!/usr/bin/env python3
"""Run one worker pool for the configured job type until SIGTERM. See /app/README.md."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from work.config import Config  # noqa: E402
from work.pool import run  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pool-id", required=True, help="this pool's id; unique per process")
    parser.add_argument("--workers", type=int, default=4, help="number of worker threads")
    args = parser.parse_args()
    return run(Config(), args.pool_id, args.workers)


if __name__ == "__main__":
    sys.exit(main())
