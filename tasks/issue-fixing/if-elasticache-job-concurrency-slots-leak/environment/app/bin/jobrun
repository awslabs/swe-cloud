#!/usr/bin/env python3
"""Stand-in for the production job runner: does the job's work (sleeps for --duration-ms) and exits 0.

The production runner opens the partner session, does the work, and closes the session when it exits.
"""

import argparse
import sys
import time


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--job-id", required=True)
    parser.add_argument("--pool-id", required=True)
    parser.add_argument("--duration-ms", type=int, default=0)
    args = parser.parse_args()
    time.sleep(args.duration_ms / 1000.0)
    print(f"done {args.job_id} on {args.pool_id}", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
